  "case_count": 3,
  "paper_results_eligible": true,
  "paper_results_eligibility_semantics": "Protocol eligibility under the frozen case gates; not validation of scientific truth, accuracy, significance, or external reproducibility.",
  "ineligibility_reasons": [],
  "protocol_version": "matrouter.paper-three-case-protocol",
  "research_questions": {
    "RQ1": "Does one all-qualified aggregate Bundle contain records from multiple heterogeneous sources and providers while preserving a typed SourceOutcome for every qualified route?",
    "RQ2": "Compared with a deterministic six-field common-record projection from the exact same primary aggregate Bundle bytes, what execution, completeness, context, provenance, and artifact information does the full Bundle preserve?",
    "RQ3": "Can preregistered exact-target follow-up artifacts enter explicit methods directly without hidden requery inside those methods?"
  },
  "rq3_method_applicability": {
    "mos2-band-gap": {
      "status": "applicable",
      "expected_method_names": [
        "match_structures",
        "render_band_structure",
        "render_density_of_states"
      ],
      "success_policy": "all_preregistered",
      "reason": "Two preregistered exact structures can enter one transparent StructureMatcher call, and complete exact MP band/DOS artifacts can each be rendered once without hidden retrieval or case logic inside MatRouter core."
    },
    "lifepo4-stability": {
      "status": "applicable",
      "expected_method_names": [
        "compute_phase_diagrams"
      ],
      "success_policy": "at_least_one",
      "reason": "A complete exact Materials Project compatibility-mixed entry set can enter the explicit phase-diagram method without reconstructing or mixing inputs."
    },
    "bi2se3-topology": {
      "status": "not_applicable",
      "expected_method_names": [],
      "success_policy": "not_applicable",
      "reason": "MatRouter exposes no general explicit topology-validation method; this case evaluates exact source-native SOC-conditioned topology acquisition only."
    }
  },
  "core_boundary": "capability/route truth -> SourceOutcome -> canonical EvidenceBundle",
