  "paper_results_eligible": false,
  "paper_results_eligibility_semantics": "Protocol eligibility under the frozen case gates; not validation of scientific truth, accuracy, significance, or external reproducibility.",
  "ineligibility_reasons": [
    "mos2-band-gap did not meet its preregistered case-level eligibility condition or has an unresolved product blocker.",
    "lifepo4-stability did not meet its preregistered case-level eligibility condition or has an unresolved product blocker."
  ],
  "protocol_version": "matrouter.paper-three-case-protocol",
  "research_questions": {
    "RQ1": "Within the declared catalog, configuration, scope, and budgets, does one all-qualified aggregate attempt every capability-matched route and preserve each typed outcome and RecordCompleteness?",
    "RQ2": "What material-data landscape does the cross-source aggregate provide for the case—sources, data categories, scientific contexts, specialist data, and explicit gaps—and how does that landscape guide the next research step?",
    "RQ3": "Can an Agent use the aggregate to locate preregistered exact source-bound records and artifacts for explicit lightweight methods, while making unsupported heavy calculations an explicit external handoff rather than a proxy result?"
  },
  "rq3_method_applicability": {
    "mos2-band-gap": {
      "status": "applicable",
      "expected_method_names": [
        "match_structures",
        "render_band_structure",
        "render_density_of_states"
      ],
      "success_policy": "all_preregistered",
      "reason": "Two preregistered exact structures can enter one transparent StructureMatcher call, and complete exact MP band/DOS artifacts can each be rendered once without hidden retrieval or case logic inside MatRouter core."
    },
    "lifepo4-stability": {
      "status": "applicable",
      "expected_method_names": [
        "compute_phase_diagrams"
      ],
      "success_policy": "at_least_one",
      "reason": "A complete exact Materials Project compatibility-mixed entry set can enter the explicit phase-diagram method without reconstructing or mixing inputs."
    },
    "bi2se3-topology": {
      "status": "not_applicable",
      "expected_method_names": [],
      "success_policy": "not_applicable",
      "reason": "MatRouter exposes no general explicit topology-validation method; this case evaluates exact source-native SOC-conditioned topology acquisition only."
    }
  },
  "core_boundary": "MatRouter routes source-qualified evidence and exact method inputs; the Agent builds the case-specific material landscape and scientific handoff.",
